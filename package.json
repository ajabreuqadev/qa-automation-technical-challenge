{
  "name": "qa-automation-technical-assessment",
  "version": "1.0.0",
  "private": true,
  "description": "Practice project: SauceDemo UI, Restful Booker API, and JMeter",
  "scripts": {
    "test": "playwright test",
    "test:e2e": "playwright test --project=chromium --project=firefox",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --project=chromium --headed",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
